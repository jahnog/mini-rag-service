# Paths
DATA_DIR=data

# Embeddings (ingest / index)
EMBEDDING_API_KEY=sk-local
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_BACKEND=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_S=120
EMBEDDING_MAX_CHARS=2048

# Chat LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4-1-fast
LLM_TIMEOUT_S=60
LLM_ENABLE_THINKING=true
# false disables llama.cpp / Qwen thinking. api.x.ai never gets extra_body.
DEMO_API_KEY=
MAX_MESSAGE_CHARS=4000
MAX_CONTEXT_CHARS=12000

# Retrieval
DEFAULT_K=5
MAX_K=8

# Chat rate limit
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_S=60
CHAT_TURNS_PER_EMAIL_DAY=30
CHAT_TURNS_PER_PROCESS_DAY=100

# Corpus ingest
DOWNLOAD_CONCURRENCY=3
DOWNLOAD_DELAY_S=0.2
USER_AGENT=BCRAMiniRag/0.1 (CAMEX corpus ingest)

# Auth (bcra_rag.auth)
AUTH_SECRET=
AUTH_ALLOWED_EMAILS=
# comma-separated allowlist; * sends to any well-formed mailbox; empty sends no codes
AUTH_COOKIE_NAME=session
AUTH_SESSION_DAYS=1
AUTH_OTP_TTL_S=300
AUTH_OTP_DIGITS=6
AUTH_TRUST_PROXY=false
AUTH_PUBLIC_ORIGIN=
# public https origin: Secure cookies, /auth POST origin checks, and the login URL in mail
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_STARTTLS=true
AUTH_SMTP_TIMEOUT_S=10

# Operator L1 / Phoenix (optional). Empty JUDGE_API_KEY falls back to LLM_API_KEY.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=bcra-rag-prod
PHOENIX_API_KEY=
# JUDGE_MODEL=grok-4.3
# JUDGE_BASE_URL=https://api.x.ai/v1
# JUDGE_API_KEY=
# JUDGE_REASONING_EFFORT=none
# CHAT_TURN_EVALS=false

