DATA_DIR=data
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BACKEND=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_S=120
EMBEDDING_MAX_CHARS=2048
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4-1-fast
DEMO_API_KEY=
MAX_MESSAGE_CHARS=4000
MAX_CONTEXT_CHARS=12000
LLM_TIMEOUT_S=60
LLM_ENABLE_THINKING=true
# false disables llama.cpp / Qwen thinking. api.x.ai never gets extra_body.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=bcra-rag
# Operator L1 judge (bcra_rag.evals). Empty JUDGE_API_KEY falls back to LLM_API_KEY.
JUDGE_MODEL=grok-4.3
JUDGE_BASE_URL=https://api.x.ai/v1
JUDGE_API_KEY=
JUDGE_REASONING_EFFORT=none
DEFAULT_K=5
MAX_K=8
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_S=60
DOWNLOAD_CONCURRENCY=3
DOWNLOAD_DELAY_S=0.2
USER_AGENT=BCRAMiniRag/0.1 (CAMEX corpus ingest)
